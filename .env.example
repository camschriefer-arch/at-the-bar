# Client config (safe to ship in the app bundle).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Google Maps, used on Android only; iOS renders with Apple Maps and needs no key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=your-android-restricted-key
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=fallback-when-unrestricted

# Only used by scripts/import-bars.mjs. Never put this in the app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
