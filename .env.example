# Client config (safe to ship in the app bundle).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Google Maps, used on both platforms. A key can carry only one application
# restriction, so use one key per platform (either alone falls back to the
# unsuffixed name below).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=your-ios-restricted-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=your-android-restricted-key
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=fallback-key-for-both

# Only used by scripts/import-bars.mjs. Never put this in the app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
